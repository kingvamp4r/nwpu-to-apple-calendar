[Unit]
Description=Private NWPU ICS subscription endpoint

[Service]
Type=simple
WorkingDirectory=%h/nwpu-to-apple-calendar
ExecStart=%h/nwpu-to-apple-calendar/.venv/bin/python subscription.py serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
